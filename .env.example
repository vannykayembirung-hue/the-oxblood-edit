DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
AUTH_SECRET=replace_with_a_long_random_secret
BLOB_READ_WRITE_TOKEN=replace_with_vercel_blob_token
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Newsletter consent (optional). Salt used to hash subscriber IPs for the
# consent record; falls back to AUTH_SECRET when unset.
NEWSLETTER_CONSENT_SALT=replace_with_a_random_salt
# Set to "true" in production to return the double opt-in link in the
# /api/subscribe response (useful until a mail provider is wired up).
NEWSLETTER_DEBUG_LINKS=false
